{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "RelativePath": {
            "type": "string",
            "$ref": "#/$defs/Text",
            "maxLength": 1024,
            "not": {
                "pattern": "^[/-]|//|/$|(^|/)\\.\\.?(/|$)"
            }
        },
        "ReviewCategory": {
            "enum": [
                "correctness",
                "security",
                "repository-rule",
                "test-coverage"
            ]
        },
        "ReviewFinding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "category": {
                    "$ref": "#/$defs/ReviewCategory"
                },
                "failure_scenario": {
                    "type": "string",
                    "$ref": "#/$defs/Text",
                    "maxLength": 2000
                },
                "line": {
                    "allOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer",
                            "maximum": 1E+6,
                            "minimum": 1
                        }
                    ]
                },
                "path": {
                    "$ref": "#/$defs/RelativePath"
                },
                "severity": {
                    "$ref": "#/$defs/ReviewSeverity"
                },
                "summary": {
                    "$ref": "#/$defs/ShortText"
                }
            },
            "required": [
                "category",
                "failure_scenario",
                "line",
                "path",
                "severity",
                "summary"
            ]
        },
        "ReviewSeverity": {
            "enum": [
                "high",
                "medium",
                "low"
            ]
        },
        "ShortText": {
            "type": "string",
            "$ref": "#/$defs/Text",
            "maxLength": 512
        },
        "Text": {
            "type": "string",
            "description": "No control characters (Unicode category Cc), so text cannot carry terminal escapes.",
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "findings": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/ReviewFinding"
            },
            "maxItems": 20
        }
    },
    "required": [
        "findings"
    ]
}
