{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Page",
  "type": "object",
  "properties": {
    "actors": {
      "description": "Who acts on a design sheet. Each actor owns one tint slot, and everything it does\nis drawn in that slot's colours.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Actor"
      },
      "maxItems": 8
    },
    "badge": {
      "description": "The pill before the kicker, printed uppercase, for example Draft; absent draws none.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400,
      "minLength": 1
    },
    "bend": {
      "description": "How a routed link draws its bends; absent is arc. A line kind's bend wins.",
      "anyOf": [
        {
          "$ref": "#/$defs/Bend"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 256,
      "minItems": 1
    },
    "chrome": {
      "$ref": "#/$defs/Chrome"
    },
    "corner": {
      "description": "The radius of every routed link's bends; absent is 6, 0 draws square corners. A line\nkind of the grammar that sets its own wins.",
      "type": [
        "number",
        "null"
      ],
      "format": "float",
      "maximum": 16.0,
      "minimum": 0.0
    },
    "foot": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400,
      "minLength": 1
    },
    "grammar": {
      "description": "A built-in grammar name or a path ending in `.json`; absent means gcp.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(gcp|plain|[^\\u0000-\\u001F]{1,395}\\.json)$"
    },
    "kicker": {
      "type": "string",
      "maxLength": 400,
      "minLength": 1
    },
    "lede": {
      "type": "string",
      "maxLength": 400,
      "minLength": 1
    },
    "legend": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LegendEntry"
      },
      "maxItems": 16
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Link"
      },
      "maxItems": 256
    },
    "projection": {
      "$ref": "#/$defs/Projection"
    },
    "sheet": {
      "description": "Draws the page as a design sheet (section 14): a frame with grid references, a title\nblock and numbered Views. Flat only.",
      "anyOf": [
        {
          "$ref": "#/$defs/Sheet"
        },
        {
          "type": "null"
        }
      ]
    },
    "theme": {
      "description": "A built-in theme name or a path ending in `.json`; absent means center.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(center|paper|dusk|clear|clear-dark|wire|tokyo-night|solarized-light|solarized-dark|material-dark|gruvbox-dark|dracula|nord|[^\\u0000-\\u001F]{1,395}\\.json)$"
    },
    "theme_overrides": {
      "description": "A partial theme merged onto the resolved theme (section 13.4 rule 8).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "title": {
      "type": "string",
      "maxLength": 400,
      "minLength": 1
    },
    "width": {
      "type": "integer",
      "format": "uint32",
      "default": 1280,
      "maximum": 2560,
      "minimum": 640
    }
  },
  "additionalProperties": false,
  "required": [
    "title",
    "kicker",
    "lede",
    "body",
    "legend"
  ],
  "$defs": {
    "Actor": {
      "description": "Who acts on a design sheet: a lane of a Phases node, a chip in the legend strip, and\nthe colour of every node and line it owns.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique among the actors.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "name": {
          "description": "Printed upper case in lane names and the legend strip.",
          "type": "string",
          "maxLength": 400,
          "minLength": 1
        },
        "text": {
          "description": "The line under the name: what the actor does.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400,
          "minLength": 1
        },
        "tint": {
          "description": "The tint slot the actor is drawn in; unique on the page.",
          "type": "integer",
          "format": "uint8",
          "maximum": 8,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "tint"
      ]
    },
    "Answer": {
      "type": "object",
      "properties": {
        "caption": {
          "description": "The cell caption; absent prints `Answer`.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60,
          "minLength": 1
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnswerParagraph"
          },
          "maxItems": 4
        },
        "statement": {
          "type": "string",
          "maxLength": 400,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "statement"
      ]
    },
    "AnswerParagraph": {
      "description": "A paragraph: a string, or `{\"lead\": ..., \"text\": ...}`, drawn as a bold lead with its\ntext continuing on the lead's last line.",
      "anyOf": [
        {
          "type": "string",
          "maxLength": 400,
          "minLength": 1
        },
        {
          "$ref": "#/$defs/LedParagraph"
        }
      ]
    },
    "Arrow": {
      "type": "string",
      "enum": [
        "none",
        "end",
        "start",
        "both"
      ]
    },
    "Attention": {
      "description": "What the reader is asked to attend to. A sheet always draws this cell, so it holds at\nleast one item.",
      "type": "object",
      "properties": {
        "caption": {
          "description": "The cell caption; absent prints `Attention`.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60,
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttentionItem"
          },
          "maxItems": 8,
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "items"
      ]
    },
    "AttentionItem": {
      "type": "object",
      "properties": {
        "actor": {
          "description": "The actor who attends to the item.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "id": {
          "description": "Unique among the attention items.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "lead": {
          "description": "Drawn bold before `text` with one space between, so the lead carries its own\npunctuation.",
          "type": "string",
          "maxLength": 400,
          "minLength": 1
        },
        "text": {
          "type": "string",
          "maxLength": 400,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "lead",
        "text"
      ]
    },
    "Axis": {
      "description": "The reading axis of a tag under iso (section 12.4): along flat x, reading down-right on\nscreen, or along flat y, reading up-right.",
      "type": "string",
      "enum": [
        "x",
        "y"
      ]
    },
    "BandLook": {
      "description": "A lane's band. wash: the actor's fill mixed halfway toward the paper, with the drafting\ngrid drawn over it. none: no band, so the paper and grid show; the bar, name and rules\nstay.",
      "type": "string",
      "enum": [
        "wash",
        "none"
      ]
    },
    "Bend": {
      "description": "The curve a routed link takes through a bend: a quarter circle, a cubic whose control\npoints both sit on the corner, which meets each leg with no jump in curvature, or a\nspline: a quadratic from the middle of one leg to the middle of the next with its control\npoint on the corner, so the whole route is one smooth curve.",
      "type": "string",
      "enum": [
        "arc",
        "curve",
        "spline"
      ]
    },
    "CalloutKind": {
      "type": "string",
      "enum": [
        "note",
        "risk",
        "decision",
        "open"
      ]
    },
    "Chrome": {
      "description": "Whether layout draws the badge, kicker, title and lede (section 13.7).",
      "type": "string",
      "enum": [
        "full",
        "none"
      ]
    },
    "FactEntry": {
      "description": "A fact inside an Item.",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/FactSource"
        },
        "text": {
          "type": "string",
          "maxLength": 400,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "FactSource": {
      "description": "Where a fact comes from (section 13.7): `doc` is read from the live documentation when\nthe figure was authored, `built` is an as-built name read off the running system (a\nbucket, a VLAN ID, a project id), and `ask` is an open question for the reader.",
      "type": "string",
      "enum": [
        "doc",
        "built",
        "ask"
      ]
    },
    "IconName": {
      "type": "string",
      "enum": [
        "agents",
        "ai-ml",
        "bigquery",
        "cloud-run-flat",
        "cloud-run",
        "cloud-sql",
        "cloud-storage",
        "compute-engine",
        "compute",
        "containers",
        "data-analytics",
        "databases",
        "devops",
        "gke",
        "hybrid",
        "integration",
        "networking",
        "observability",
        "scc",
        "security-identity",
        "serverless",
        "storage",
        "vertex-ai"
      ]
    },
    "Justify": {
      "type": "string",
      "enum": [
        "start",
        "center",
        "end",
        "space-between"
      ]
    },
    "LedParagraph": {
      "type": "object",
      "properties": {
        "lead": {
          "type": "string",
          "maxLength": 400,
          "minLength": 1
        },
        "text": {
          "type": "string",
          "maxLength": 400,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "lead",
        "text"
      ]
    },
    "LegendEntry": {
      "type": "object",
      "properties": {
        "by_actor": {
          "description": "On a page with actors, the entry names every use of its line and form that has an\neffective actor; each is drawn in its actor's colour.",
          "type": "boolean"
        },
        "form": {
          "description": "The form of the pipes this entry names: a tube (the default) or a band. A band and\na tube of one line and tint are two legend entries, and the swatch draws the form.",
          "$ref": "#/$defs/PipeForm"
        },
        "line": {
          "$ref": "#/$defs/Line"
        },
        "text": {
          "type": "string",
          "maxLength": 400,
          "minLength": 1
        },
        "tint": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 8,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "line",
        "text"
      ]
    },
    "Line": {
      "type": "string",
      "enum": [
        "gray",
        "solid",
        "dash",
        "deny"
      ]
    },
    "Link": {
      "type": "object",
      "properties": {
        "actor": {
          "description": "On a design sheet, the actor whose colour the link takes; absent takes the actor of\nthe node it leaves.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "arrow": {
          "$ref": "#/$defs/Arrow",
          "default": "end"
        },
        "axis": {
          "description": "Under iso, the axis the tag reads along; absent follows the leg it sits on.",
          "anyOf": [
            {
              "$ref": "#/$defs/Axis"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "type": "string"
        },
        "from_side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400,
          "minLength": 1
        },
        "line": {
          "$ref": "#/$defs/Line"
        },
        "order": {
          "description": "The message position along the time axis when the link joins two lane heads of one\nLanes node (section 13.6).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 256,
          "minimum": 1
        },
        "sub": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400,
          "minLength": 1
        },
        "tint": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 8,
          "minimum": 1
        },
        "to": {
          "type": "string"
        },
        "to_side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ]
        },
        "via": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PagePoint"
          },
          "maxItems": 8
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "line"
      ]
    },
    "ListKind": {
      "type": "string",
      "enum": [
        "plain",
        "numbered",
        "bulleted"
      ]
    },
    "Node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              },
              "maxItems": 256,
              "minItems": 1
            },
            "gap": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 64,
              "minimum": 0
            },
            "grow": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0
              }
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "justify": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Justify"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tag": {
              "type": "string",
              "const": "Row"
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "children"
          ]
        },
        {
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              },
              "maxItems": 256,
              "minItems": 1
            },
            "gap": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 64,
              "minimum": 0
            },
            "grow": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0
              }
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "justify": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Justify"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tag": {
              "type": "string",
              "const": "Col"
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "children"
          ]
        },
        {
          "description": "Lane heads that share one time axis (section 13.6). Each child is a lane head; a Link\nwith `order` between two heads of one Lanes node is a message, drawn as a horizontal\narrow in the band below the heads.",
          "type": "object",
          "properties": {
            "children": {
              "description": "The lane heads, left to right: 1 to 32 nodes.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              },
              "maxItems": 32,
              "minItems": 1
            },
            "gap": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 64,
              "minimum": 0
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "tag": {
              "type": "string",
              "const": "Lanes"
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "children"
          ]
        },
        {
          "description": "Any container. `kind` names one of the grammar's container kinds.",
          "type": "object",
          "properties": {
            "actor": {
              "description": "On a design sheet, the actor whose colour the Box takes.",
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              },
              "maxItems": 256,
              "minItems": 1
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "label": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "const": "Box"
            },
            "tint": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 8,
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "kind",
            "label",
            "children"
          ]
        },
        {
          "description": "Any named leaf. `kind` names one of the grammar's item kinds.",
          "type": "object",
          "properties": {
            "actor": {
              "description": "On a design sheet, the actor whose colour the Item takes.",
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "facts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FactEntry"
              },
              "maxItems": 8
            },
            "icon": {
              "anyOf": [
                {
                  "$ref": "#/$defs/IconName"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "shape": {
              "description": "Under iso, the solid the item stands as; absent takes the shape of its icon's row\nin the kind's product table, or card.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Shape"
                },
                {
                  "type": "null"
                }
              ]
            },
            "subtitle": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 400,
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "const": "Item"
            },
            "title": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "kind",
            "title"
          ]
        },
        {
          "description": "The Fact node: a fact standing on its own in a container.",
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "source": {
              "$ref": "#/$defs/FactSource"
            },
            "tag": {
              "type": "string",
              "const": "Fact"
            },
            "text": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "kind": {
              "$ref": "#/$defs/NoteKind"
            },
            "tag": {
              "type": "string",
              "const": "Note"
            },
            "text": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "actor": {
              "description": "On a design sheet, the actor whose colour the pipe takes; absent takes the actor of\nits `from` node.",
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "arrow": {
              "$ref": "#/$defs/Arrow"
            },
            "axis": {
              "description": "Under iso, the axis the tag reads along; absent follows dir.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Axis"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dir": {
              "$ref": "#/$defs/PipeDir"
            },
            "form": {
              "description": "Under iso, a round tube on the pipe's plane (the default) or a band, a flat wide\narrow lying on it (section 12.3 rule 5).",
              "$ref": "#/$defs/PipeForm"
            },
            "from": {
              "description": "The id of the node on the pipe's left (h) or upper (v) end. Layout centers the pipe's\nslot on its targets (section 13.8); a Tee arm cannot carry one.",
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "id": {
              "type": [
                "string",
                "null"
