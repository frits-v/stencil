{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Page",
  "type": "object",
  "properties": {
    "body": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 256,
      "minItems": 1
    },
    "canvas": {
      "$ref": "#/$defs/Canvas"
    },
    "chrome": {
      "$ref": "#/$defs/Chrome"
    },
    "foot": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400,
      "minLength": 1
    },
    "grammar": {
      "description": "A built-in grammar name or a path ending in `.json`; absent means gcp.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(gcp|plain|[^\\u0000-\\u001F]{1,395}\\.json)$"
    },
    "kicker": {
      "type": "string",
      "maxLength": 400,
      "minLength": 1
    },
    "lede": {
      "type": "string",
      "maxLength": 400,
      "minLength": 1
    },
    "legend": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LegendEntry"
      },
      "maxItems": 16
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Link"
      },
      "maxItems": 256
    },
    "projection": {
      "$ref": "#/$defs/Projection"
    },
    "theme": {
      "description": "A built-in theme name or a path ending in `.json`; absent means center.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(center|paper|dusk|clear|clear-dark|wire|[^\\u0000-\\u001F]{1,395}\\.json)$"
    },
    "theme_overrides": {
      "description": "A partial theme merged onto the resolved theme (section 13.4 rule 8).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "title": {
      "type": "string",
      "maxLength": 400,
      "minLength": 1
    },
    "width": {
      "type": "integer",
      "format": "uint32",
      "default": 1280,
      "maximum": 2560,
      "minimum": 640
    }
  },
  "additionalProperties": false,
  "required": [
    "title",
    "kicker",
    "lede",
    "canvas",
    "body",
    "legend"
  ],
  "$defs": {
    "Arrow": {
      "type": "string",
      "enum": [
        "none",
        "end",
        "start",
        "both"
      ]
    },
    "CalloutKind": {
      "type": "string",
      "enum": [
        "note",
        "risk",
        "decision",
        "open"
      ]
    },
    "Canvas": {
      "type": "string",
      "enum": [
        "customer",
        "internal"
      ]
    },
    "Chrome": {
      "description": "Whether layout draws the badge, kicker, title and lede (section 13.7).",
      "type": "string",
      "enum": [
        "full",
        "none"
      ]
    },
    "FactEntry": {
      "description": "A fact inside an Item.",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/FactSource"
        },
        "text": {
          "type": "string",
          "maxLength": 400,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "FactSource": {
      "description": "Where a fact comes from (section 13.7): `doc` is read from the live documentation when\nthe figure was authored, `built` is an as-built name read off the running system (a\nbucket, a VLAN ID, a project id), and `ask` is an open question for the reader.",
      "type": "string",
      "enum": [
        "doc",
        "built",
        "ask"
      ]
    },
    "IconName": {
      "type": "string",
      "enum": [
        "agents",
        "ai-ml",
        "bigquery",
        "cloud-run-flat",
        "cloud-run",
        "cloud-sql",
        "cloud-storage",
        "compute-engine",
        "compute",
        "containers",
        "data-analytics",
        "databases",
        "devops",
        "gke",
        "hybrid",
        "integration",
        "networking",
        "observability",
        "scc",
        "security-identity",
        "serverless",
        "storage",
        "vertex-ai"
      ]
    },
    "Justify": {
      "type": "string",
      "enum": [
        "start",
        "center",
        "end",
        "space-between"
      ]
    },
    "LegendEntry": {
      "type": "object",
      "properties": {
        "line": {
          "$ref": "#/$defs/Line"
        },
        "text": {
          "type": "string",
          "maxLength": 400,
          "minLength": 1
        },
        "tint": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 8,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "line",
        "text"
      ]
    },
    "Line": {
      "type": "string",
      "enum": [
        "gray",
        "solid",
        "dash",
        "deny"
      ]
    },
    "Link": {
      "type": "object",
      "properties": {
        "arrow": {
          "$ref": "#/$defs/Arrow",
          "default": "end"
        },
        "from": {
          "type": "string"
        },
        "from_side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400,
          "minLength": 1
        },
        "line": {
          "$ref": "#/$defs/Line"
        },
        "order": {
          "description": "The message position along the time axis when the link joins two lane heads of one\nLanes node (section 13.6).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 256,
          "minimum": 1
        },
        "sub": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400,
          "minLength": 1
        },
        "tint": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 8,
          "minimum": 1
        },
        "to": {
          "type": "string"
        },
        "to_side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ]
        },
        "via": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PagePoint"
          },
          "maxItems": 8
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "line"
      ]
    },
    "ListKind": {
      "type": "string",
      "enum": [
        "plain",
        "numbered",
        "bulleted"
      ]
    },
    "Node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              },
              "maxItems": 256,
              "minItems": 1
            },
            "gap": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 64,
              "minimum": 0
            },
            "grow": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0
              }
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "justify": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Justify"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tag": {
              "type": "string",
              "const": "Row"
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "children"
          ]
        },
        {
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              },
              "maxItems": 256,
              "minItems": 1
            },
            "gap": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 64,
              "minimum": 0
            },
            "grow": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0
              }
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "justify": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Justify"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tag": {
              "type": "string",
              "const": "Col"
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "children"
          ]
        },
        {
          "description": "Lane heads that share one time axis (section 13.6). Each child is a lane head; a Link\nwith `order` between two heads of one Lanes node is a message, drawn as a horizontal\narrow in the band below the heads.",
          "type": "object",
          "properties": {
            "children": {
              "description": "The lane heads, left to right: 1 to 32 nodes.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              },
              "maxItems": 32,
              "minItems": 1
            },
            "gap": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 64,
              "minimum": 0
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "tag": {
              "type": "string",
              "const": "Lanes"
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "children"
          ]
        },
        {
          "description": "Any container. `kind` names one of the grammar's container kinds.",
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              },
              "maxItems": 256,
              "minItems": 1
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "label": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "const": "Box"
            },
            "tint": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 8,
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "kind",
            "label",
            "children"
          ]
        },
        {
          "description": "Any named leaf. `kind` names one of the grammar's item kinds.",
          "type": "object",
          "properties": {
            "facts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FactEntry"
              },
              "maxItems": 8
            },
            "icon": {
              "anyOf": [
                {
                  "$ref": "#/$defs/IconName"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "subtitle": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 400,
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "const": "Item"
            },
            "title": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "kind",
            "title"
          ]
        },
        {
          "description": "The Fact node: a fact standing on its own in a container.",
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "source": {
              "$ref": "#/$defs/FactSource"
            },
            "tag": {
              "type": "string",
              "const": "Fact"
            },
            "text": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "kind": {
              "$ref": "#/$defs/NoteKind"
            },
            "tag": {
              "type": "string",
              "const": "Note"
            },
            "text": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "arrow": {
              "$ref": "#/$defs/Arrow"
            },
            "dir": {
              "$ref": "#/$defs/PipeDir"
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "label": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            },
            "line": {
              "$ref": "#/$defs/Line"
            },
            "sub": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 400,
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "const": "Pipe"
            },
            "tint": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 8,
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "dir",
            "line",
            "label"
          ]
        },
        {
          "type": "object",
          "properties": {
            "arms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TeeArm"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "hub": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "line": {
              "$ref": "#/$defs/Line"
            },
            "tag": {
              "type": "string",
              "const": "Tee"
            },
            "tint": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 8,
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "line",
            "hub",
            "arms"
          ]
        },
        {
          "type": "object",
          "properties": {
            "body": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 400,
                "minLength": 1
              },
              "maxItems": 64,
              "minItems": 1
            },
            "heading": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 400,
              "minLength": 1
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "list": {
              "$ref": "#/$defs/ListKind",
              "default": "plain"
            },
            "tag": {
              "type": "string",
              "const": "Text"
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "kind": {
              "$ref": "#/$defs/CalloutKind"
            },
            "tag": {
              "type": "string",
              "const": "Callout"
            },
            "text": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 400,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "height": {
              "type": "integer",
              "format": "uint16",
              "default": 200,
              "maximum": 1200,
              "minimum": 40
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "label": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "const": "Frame"
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "label"
          ]
        }
      ]
    },
    "NoteKind": {
      "type": "string",
      "enum": [
        "kicker",
        "h1",
        "lede",
        "legend",
        "foot"
      ]
    },
    "PagePoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "PipeDir": {
      "type": "string",
      "enum": [
        "h",
        "v"
      ]
    },
    "Projection": {
      "type": "string",
      "enum": [
        "flat",
        "iso"
      ]
    },
    "Side": {
      "type": "string",
      "enum": [
        "top",
        "right",
        "bottom",
        "left"
      ]
    },
    "TeeArm": {
      "description": "A Tee arm is written with `\"tag\": \"Pipe\"`, the same object shape as a Pipe node.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "arrow": {
              "$ref": "#/$defs/Arrow"
            },
            "dir": {
              "$ref": "#/$defs/PipeDir"
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "label": {
              "type": "string",
              "maxLength": 400,
              "minLength": 1
            },
            "line": {
              "$ref": "#/$defs/Line"
            },
            "sub": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 400,
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "const": "Pipe"
            },
            "tint": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 8,
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "tag",
            "dir",
            "line",
            "label"
          ]
        }
      ]
    }
  }
}
