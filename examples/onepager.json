                {
                  "tag": "PartsList",
                  "id": "parts",
                  "title": "Parts list",
                  "note": "what the service is made of, and why each part exists",
                  "parts": [
                    {
                      "id": "console",
                      "node": "console",
                      "why": "Operators write triggers and judge verdicts without an engineer in the loop."
                    },
                    {
                      "id": "gateway",
                      "node": "gateway",
                      "why": "One authenticated entry point; the API never sees an anonymous call."
                    },
                    {
                      "id": "trigger-api",
                      "node": "api",
                      "why": "Turns a description into a versioned plan and refuses to queue a plan nobody approved."
                    },
                    {
                      "id": "queue",
                      "node": "queue",
                      "why": "The API returns once a job is queued, so a slow clip never holds a request open."
                    },
                    {
                      "id": "clip-bucket",
                      "node": "bucket",
                      "why": "A clip is evaluated only once it is complete, and the arrival event names it."
                    },
                    {
                      "id": "worker",
                      "node": "worker",
                      "why": "Clips are independent, so a failed clip retries alone."
                    },
                    {
                      "id": "evaluator",
                      "node": "evaluator",
                      "why": "Reads frames against the plan, and has no write path to the store."
                    },
                    {
                      "id": "verdict-store",
                      "node": "verdict-store",
                      "why": "Every verdict keeps its evidence frames and the plan version that produced it."
                    },
                    {
                      "id": "replay",
                      "node": "replay",
                      "why": "Runs a trigger over earlier clips on a schedule, so the operator does not wait on a replay."
                    }
                  ]
                },
